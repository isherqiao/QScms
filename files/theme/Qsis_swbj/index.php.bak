    <div class="left-news">
   <?php 
    $pageTitle = '文章列表';
    if (qs_is_tag()) {
        $pageTitle = '<a href=/tags/>专题</a>：' . qs_tag_name((false));
    } 
    ?>
   
      <h3 class="list-title"><?php echo $pageTitle; ?></h3>
      <div class="list-items">
        <?php if (qs_next_post()): ?>
          <?php do { ?>
            <div class="list-item">
              <div class="title">
                <a href="<?php 
                  if (qs_is_bookname()) {
                      $id = $qs_config['current_data']['id'] ?? 'unknown';
                      echo './' . $id . '.html';
                  } else {
                      qs_post_link(); 
                  }
                ?>"><?php qs_the_title(); ?></a>
              </div>
              <div class="date"><?php qs_the_date(); ?></div>
            </div>
          <?php } while (qs_next_post()); ?>
        <?php else: ?>
          <p class="no-content">暂无内容。</p>
        <?php endif; ?>
      </div>
      <div class="pagination">
  <?php qs_pagination(); ?>
</div>
    </div>
