if (!empty($render_blocks)) {
    foreach ($render_blocks as $item) {
        $show_limit = $item['limit'] ?? $qs_config['per_page'];
        qs_block_tag_posts($item['tag_name'], $item['tag_desc'], $show_limit);
    }
}
