    <?php endif; ?>
        <!-- 简介内容（支持截取字数，不改你原有写法） -->
    <?php if (qs_the_summary()): ?>
            <?php echo qs_the_summary(200);  ?>
    <?php endif; ?>
          </div>
<?php endif; ?>
<?php } ?>

