 <?php if (qs_the_content_pic() || qs_the_summary()): // 只要有图 OR 有摘要就显示 ?>
      <div class="sidebar-box">
        <div class="sidebar-title">文章摘要</div>
    <?php if (qs_has_content_pic()): ?>
